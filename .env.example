# Environment Variables Template
PORT=4000
NODE_ENV=development

# Database & Redis
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/queueflow?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="super-secret-queueflow-jwt-key-2026"
JWT_EXPIRES_IN="7d"

# Rate Limiting & Queue Settings
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
MAX_JOB_ATTEMPTS=3
REDIS_CACHE_TTL=30
WORKER_HEARTBEAT_INTERVAL=10000
WORKER_HEARTBEAT_TIMEOUT=30000
WEBHOOK_TIMEOUT=5000
